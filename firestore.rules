rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a coleção principal 'products'
    match /products/{productId} {
      // Público pode ler produtos que não estejam ocultos (active != false)
      allow read: if resource == null || resource.data.active != false || request.auth != null;

      // Somente administrador autenticado via Firebase Auth pode criar, editar ou excluir
      allow create, update, delete: if request.auth != null;
    }

    // Regra padrão para outras coleções (permitir leitura pública, escrita protegida)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
